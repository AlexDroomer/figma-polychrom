{
  "name": "polychrom-apca-contrast-checker-figma-plugin",
  "private": false,
  "version": "6.0.0",
  "type": "module",
  "scripts": {
    "dev:ui": "vite build --watch -c vite.config.ui.ts",
    "dev:api": "vite build --watch -c vite.config.api.ts",
    "dev": "pnpm run /^dev:/",
    "build:ui": "tsc && vite build -c vite.config.ui.ts",
    "build:api": "tsc && vite build -c vite.config.api.ts",
    "build": "pnpm run /^build:/",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "prettier:format": "prettier --write ./",
    "test:lint": "eslint --ext .ts,.svelte ./src --fix",
    "test:types": "tsc --skipLibCheck --noEmit",
    "test:unit:ui": "vitest --watch=false --coverage -c vite.config.ui.ts",
    "test:unit:api": "vitest --watch=false --coverage -c vite.config.api.ts",
    "test": "pnpm run /^test:/",
    "lint:size": "size-limit"
  },
  "dependencies": {
    "@figma/plugin-typings": "^1.116.0",
    "apca-w3": "^0.1.9",
    "apcach": "^0.6.4",
    "culori": "^4.0.2",
    "nanostores": "^1.0.1",
    "svelte-floating-ui": "^1.6.2"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@svelte-put/copy": "^4.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/apca-w3": "^0.1.3",
    "@types/culori": "^4.0.0",
    "@types/node": "^24.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "csstype": "^3.1.3",
    "eslint": "^9.18.0",
    "eslint-config-love": "^121.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "nanoid": "^5.1.5",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "size-limit": "^11.2.0",
    "svelte": "^5.37.3",
    "svelte-check": "^4.3.1",
    "tailwindcss": "3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4"
  },
  "size-limit": [
    {
      "path": "dist/api.js"
    }
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
